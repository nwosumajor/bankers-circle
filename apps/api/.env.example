PORT=4000
# Local docker compose (pnpm db:up). In staging/prod DATABASE_URL is the Supavisor pooler
# and DIRECT_URL the direct connection used only for migrations (CLAUDE.md §3.1).
DATABASE_URL=postgresql://circle:circle@localhost:5433/circle
DIRECT_URL=postgresql://circle:circle@localhost:5433/circle
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
