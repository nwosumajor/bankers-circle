// Each module owns its tables (CLAUDE.md §5.1).
// Connection URLs live in prisma.config.ts (CLI) and PrismaService (runtime, via the pg adapter).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---- waitlist module -------------------------------------------------------
// Pre-launch signups (validation phase). Not member accounts: no link to the identity module.
// Enum-like columns are text validated by @circle/contracts, so options can change without a migration.
model WaitlistSignup {
  /// UUIDv7, generated by the app.
  id                   String    @id @db.Uuid
  /// Unique case-insensitively (citext).
  email                String    @unique @db.Citext
  firstName            String?   @map("first_name") @db.VarChar(50)
  subSector            String    @map("sub_sector") @db.VarChar(40)
  area                 String    @db.VarChar(40)
  interests            String[]
  /// Privacy-notice version the person agreed to, and when.
  consentPolicyVersion String    @map("consent_policy_version") @db.VarChar(20)
  consentedAt          DateTime  @map("consented_at") @db.Timestamptz(3)
  /// Set once double opt-in exists (needs the email provider).
  emailConfirmedAt     DateTime? @map("email_confirmed_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("waitlist_signups")
}
