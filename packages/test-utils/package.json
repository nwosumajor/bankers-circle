{
  "name": "@circle/test-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Factories, fixtures and Testcontainers helpers. Test-only; never import from runtime code.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "testcontainers": "^12.2.1"
  },
  "devDependencies": {
    "@circle/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3"
  }
}
